    "@tanstack/react-query-devtools": "^5",
    "@tanstack/react-router": "^1",
    "@tanstack/router-devtools": "^1",
    "class-variance-authority": "^0.7",
    "clsx": "^2",
    "lucide-react": "^0.525",
    "radix-ui": "^1.6.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3",
    "zustand": "^5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4",
    "@tanstack/router-plugin": "^1",
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16",
