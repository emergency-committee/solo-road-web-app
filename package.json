    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/ui": "^3",
    "jsdom": "^26",
    "oxlint": "^1.71.0",
    "playwright": "^1.61.1",
    "prettier": "^3",
    "prettier-plugin-tailwindcss": "^0.6",
    "tailwindcss": "^4",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vite-plugin-pwa": "^1",
    "vitest": "^3",
    "workbox-window": "^7"
  }
