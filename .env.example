# SoloRoad Web App — 환경변수 템플릿
# .env.local 파일을 복사해서 실제 값을 채우세요

# 백엔드 API 기본 URL
# 개발 시 Vite 프록시를 통해 /api 경로 사용 → 빈 문자열로 두세요
VITE_API_BASE_URL=

# solo_road_server는 X-API-Key를 검사하지 않는다 (쿠키 기반 인증만 사용). 비워둬도 된다.
VITE_API_KEY=

# 카카오 디벨로퍼스 > 내 애플리케이션 > 앱 키 > REST API 키
# Redirect URI는 카카오 디벨로퍼스에 {origin}/login/kakao/callback 형태로 등록되어 있어야 한다.
VITE_KAKAO_REST_API_KEY=your-kakao-rest-api-key-here

# 카카오 디벨로퍼스 > 내 애플리케이션 > 앱 키 > JavaScript 키 (REST API 키와 다름! 카카오맵 SDK 전용)
# 플랫폼 > Web에 서비스 도메인이 등록되어 있어야 지도가 로드된다.
VITE_KAKAO_JS_KEY=your-kakao-javascript-key-here

# 필요할 때만 TanStack 개발 도구 표시
VITE_ENABLE_DEVTOOLS=false

# 백엔드 온보딩 저장 엔드포인트가 아직 없을 때 로컬 개발용 mock 사용
# (true면 카카오 로그인 버튼 클릭 시 실제 OAuth 없이 바로 다음 화면으로 넘어간다)
VITE_AUTH_MOCK=true

# 혼밥 평점 데모 장소를 지도와 상세 화면에 함께 표시
# 실제 데이터만 사용하려면 false로 변경
VITE_PLACE_DEMO_ENABLED=true
